# Salin ke .env lalu sesuaikan.
# Variabel VITE_* ikut terkirim ke bundle dan terlihat publik — jangan simpan secret di sini.

# 'true' saat dijalankan di mesin lokal. Mengaktifkan proxy dev supaya tidak kena CORS.
VITE_IS_LOCAL=true

# Port server dev Vite.
VITE_PORT=3000

# Host yang boleh mengakses server dev, dipisah koma.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Base URL khusus endpoint login (backend SSO), termasuk prefix path.
# Bila dikosongkan, login memakai VITE_API_BASE_URL.
VITE_API_LOGIN_URL=

# Base URL untuk semua permintaan setelah login, termasuk prefix path.
VITE_API_BASE_URL=https://dev-api-lms.motorsights.com/api/lms
